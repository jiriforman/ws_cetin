# Frontend (Vite) – copy to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_PROJECT_ID="your-supabase-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-supabase-project-ref.supabase.co"

# Edge-function secrets – set in Supabase/Lovable Cloud → Secrets, NEVER in .env or git.
# The values below were randomly generated for this template; generate your own:
#   openssl rand -base64 24
# ADMIN_PASSWORD="0ZlAXfZXu6mxLaXOnoNUDGaf"
# WEBHOOK_SECRET="eebb6cf207416d5fb09e3c7e4c31e8d54a9362b82baf0ad2"
# ANTHROPIC_API_KEY="sk-ant-..."     # negotiation room, default provider
# LOVABLE_API_KEY="..."              # only if provider = lovable
# HIDE_TEAM_CODES="true"             # optional
